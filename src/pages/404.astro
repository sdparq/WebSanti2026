---
// Página no encontrada. Bilingüe en una sola página porque Netlify
// sirve un único 404 para todo el sitio.
import '../styles/global.css';
import { site } from '../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — {site.nameFull}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="nf">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Page not found · Página no encontrada</h1>
      <p class="nf__links">
        <a href="/en/">Go to the home page</a>
        <span aria-hidden="true"> · </span>
        <a href="/es/">Ir a la portada</a>
      </p>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    background: var(--bone, #f5f2ec);
    color: var(--ink, #0a0a0a);
    text-align: center;
  }
  .nf__code {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
  }
  .nf__title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    letter-spacing: 0.02em;
  }
  .nf__links a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
